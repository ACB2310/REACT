# Copia este archivo como .env.local y pon los valores de tu proyecto de Supabase
# (Project Settings → Data API / API Keys). .env.local no se sube al repo.
#
# Solo van aquí la URL y la Publishable key (sb_publishable_…), que son públicas:
# lo que protege los datos son las políticas RLS.
# NUNCA pongas aquí la Secret key (sb_secret_…, antes "service_role").

# URL base, sin /rest/v1 al final
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
